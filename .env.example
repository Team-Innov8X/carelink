MONGODB_URI=mongodb://localhost:27017/carelink
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Driver SOS offer alerts are at least 40 seconds; request timeout keeps a buffer.
SOS_OFFER_SECONDS=40
SOS_REQUEST_TIMEOUT_SECONDS=45

# Optional performance timings for session, DB, and external lookups.
CARELINK_PERF_LOGS=0
NEXT_PUBLIC_CARELINK_PERF_LOGS=0

# Optional: enables Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional provider for Symptom Triage (OpenAI-compatible chat completions endpoint).
# Keep the key in .env.local and never commit it.
TRIAGE_API_URL=
TRIAGE_API_KEY=
TRIAGE_MODEL=
TRIAGE_TIMEOUT_MS=12000
EMERGENCY_FALLBACK_TEXT=Please seek emergency care now or contact your local emergency services.

# Optional legacy Grok/xAI provider. Symptom Triage accepts these as defaults;
# explicit TRIAGE_API_* values take precedence. Smart Match also uses these values.
# Without these values, Smart Match uses its deterministic local criteria parser.
GROK_API_KEY=
GROK_MODEL=
# Optional OpenAI-compatible endpoint override; defaults to https://api.x.ai/v1/chat/completions
GROK_API_URL=

# Optional Groq provider for Smart Match natural-language criteria parsing.
# When configured, Smart Match prefers Groq over GROK_API_KEY.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Set true for the guided demo navigation allowlist in lib/demo-config.ts.
NEXT_PUBLIC_DEMO_MODE=false
