MONGODB_URI=mongodb://localhost:27017/carelink
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Optional performance timings for session, DB, and external lookups.
CARELINK_PERF_LOGS=0
NEXT_PUBLIC_CARELINK_PERF_LOGS=0

# Optional: enables Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-side Places and geocoding data. Phone details are fetched on demand.
GOOGLE_MAPS_API_KEY=

# Server-only Grok/xAI-compatible chat configuration. Set AI_MODEL to an ID
# available to your API key in the xAI Console; do not enable data sharing.
AI_BASE_URL=https://api.x.ai/v1
AI_API_KEY=
AI_MODEL=
