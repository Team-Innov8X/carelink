MONGODB_URI=mongodb://localhost:27017/carelink
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Optional performance timings for session, DB, and external lookups.
CARELINK_PERF_LOGS=0
NEXT_PUBLIC_CARELINK_PERF_LOGS=0

# Optional: enables Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Grok/xAI provider used by Symptom Triage.
# Without these values, Smart Match uses its deterministic local criteria parser.
GROK_API_KEY=
GROK_MODEL=
# Optional OpenAI-compatible endpoint override; defaults to https://api.x.ai/v1/chat/completions
GROK_API_URL=

# Optional Groq provider used by Symptom Triage.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Optional Google Gemini provider for Smart Match criteria parsing and grounded explanation emphasis.
# Keep this server-only; never prefix it with NEXT_PUBLIC_. Defaults to gemini-3.8-flash.
GEMINI_API_KEY=
